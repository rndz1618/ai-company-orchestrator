# Copy to .env next to docker-compose.yml (optional — defaults work for local)

SECRET_KEY=dev-docker-change-me
ALLOWED_ORIGINS=http://localhost:8080,http://localhost:5173

# Leave empty for open API in local demo
ORCHESTRATOR_API_KEY=

# Free LLM (recommended for first runs)
GROQ_API_KEY=

# Paid (optional)
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
